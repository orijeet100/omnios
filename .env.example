# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Restart `npm run dev` after changing it.

VITE_CLERK_PUBLISHABLE_KEY=

# Photon Health e-prescribing (optional). Leave the token empty to use the
# built-in mock: no network call is made and prescriptions are simulated.
VITE_PHOTON_CLIENT_ID=
VITE_PHOTON_AUTH_TOKEN=
VITE_PHOTON_API_URL=https://api.neutron.health/graphql
